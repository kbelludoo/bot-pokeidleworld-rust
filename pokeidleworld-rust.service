[Unit]
Description=Poke Idle World Autonomous Bot (Native Rust Zero-GC Engine)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/bots-rust/bot-pokeidleworld-rust
ExecStart=/home/ubuntu/bots-rust/bot-pokeidleworld-rust/bot-pokeidleworld-rust
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
Environment=RUST_LOG=info
Environment=PORT=3012

[Install]
WantedBy=multi-user.target
